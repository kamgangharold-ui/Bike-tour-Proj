{
  "_collection": "rides",
  "_description": "One document per completed ride, written by the app when the user ends a ride. Read/write restricted to the owning user via user_uid.",

  "_document_id": "auto-generated by Firestore",

  "fields": {
    "user_uid": {
      "type": "String",
      "required": true,
      "example": "abc123XYZ",
      "note": "Firebase Auth UID of the owner; security rules match on this field"
    },
    "started_at": {
      "type": "Timestamp",
      "required": true,
      "note": "When the ride was started"
    },
    "ended_at": {
      "type": "Timestamp",
      "required": true,
      "note": "Set server-side with FieldValue.serverTimestamp()"
    },
    "mode": {
      "type": "String",
      "required": true,
      "enum": ["tour", "free"],
      "example": "tour"
    },
    "tour_id": {
      "type": "String",
      "required": false,
      "example": "gaudi-highlights",
      "note": "null for free rides"
    },
    "visited_slugs": {
      "type": "Array<String>",
      "required": true,
      "example": ["casa-batllo", "sagrada-familia"]
    },
    "distance_km": {
      "type": "Number",
      "required": true,
      "example": 4.2
    }
  },

  "_example_document": {
    "user_uid": "abc123XYZ",
    "started_at": "SERVER_TIMESTAMP",
    "ended_at": "SERVER_TIMESTAMP",
    "mode": "tour",
    "tour_id": "gaudi-highlights",
    "visited_slugs": ["casa-batllo", "sagrada-familia", "park-guell"],
    "distance_km": 6.4
  }
}
